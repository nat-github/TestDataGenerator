{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthetic-data-platform/schemas/sdp_config.schema.json",
  "title": "Synthetic Data Platform — config (YAML/JSON)",
  "description": "Canonical schema for sdp-yaml-v1 / sdp-json-v1 configs. Use in IDEs (VS Code, IntelliJ) for autocompletion and validation.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^(x-|_)": {
      "description": "Annotation escape hatch. Keys prefixed with `x-` or `_` are ignored by the parser and never validated, so you can carry your own metadata without weakening the schema."
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "description": "IDE schema reference. Json_Config_Schema.md documents adding this, so it must be allowed at the root."
    },
    "notes": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ],
      "description": "Free-text notes about this config — a string or a list of lines."
    },
    "source_workbook": { "type": "string", "description": "Provenance — the workbook this config was generated from." },
    "config_format": {
      "type": "string",
      "anyOf": [
        { "enum": ["sdp-yaml-v1", "sdp-json-v1", "fdl-yaml-v1", "fdl-json-v1"] },
        { "pattern": "^(sdp|fdl)-" }
      ],
      "description": "Format marker. The parser does not read this field, so the schema does not constrain it beyond an `sdp-`/`fdl-` prefix — being stricter here than the implementation would fail configs that work. The enum drives IDE autocompletion."
    },
    "config_version": { "type": "string" },
    "run_settings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "seed": { "type": "integer" },
        "default_records_per_table": { "type": "integer", "minimum": 1 },
        "output_format": { "type": "string", "enum": ["parquet", "json", "csv"] },
        "compression": { "type": "string", "enum": ["snappy", "gzip", "zstd", "none"] },
        "operation_column": { "type": "string" },
        "save_model_artifact": { "type": "boolean" },
        "model_artifact_path": { "type": "string" }
      }
    },
    "tables": {
      "type": "array",
      "items": { "$ref": "#/$defs/Table" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/Relationship" }
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/Workflow" },
      "description": "Layer C — lifecycle state machines. See Rules_and_Workflows.md."
    }
  },
  "$defs": {
    "Table": {
      "type": "object",
      "required": ["name", "columns"],
      "additionalProperties": false,
      "patternProperties": { "^(x-|_)": {} },
      "properties": {
        "name": { "type": "string" },
        "table_name": { "type": "string", "description": "Alias for name." },
        "description": { "type": "string" },
        "num_rows": { "type": "integer", "minimum": 0, "description": "Rows to generate. Alias of rows/row_count." },
        "seed": { "type": "integer", "description": "Per-table seed override." },
        "output_format": { "type": "string", "enum": ["parquet", "json", "csv"] },
        "omitted_columns": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ],
          "description": "Documentation of columns intentionally left out of this config."
        },
        "source": {
          "type": "string",
          "description": "Anchored generation — load this table verbatim from a real .parquet/.csv dataset instead of generating it. Other tables generate around it and resolve FKs against its real keys. See Yaml_Config_Schema.md."
        },
        "versions_per_key": {
          "type": "integer",
          "minimum": 1,
          "description": "Repeat each business key 1..N times, varying scd2_tracked_columns. Schema is unchanged."
        },
        "table_kind": {
          "type": "string",
          "enum": ["transactional", "dimension", "reference", "fact", "bridge"]
        },
        "rows": { "type": "integer", "minimum": 0 },
        "row_count": { "type": "integer", "minimum": 0 },
        "active": { "type": "boolean" },
        "notes": { "type": "string" },
        "primary_key_columns": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ]
        },
        "business_key_columns": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ]
        },
        "cdc": { "$ref": "#/$defs/CDC" },
        "delta": { "type": "boolean", "description": "Legacy alias of cdc.mode == delta." },
        "delta_eligible": { "type": "boolean", "description": "Legacy flag — prefer cdc.mode." },
        "scd2": { "type": "boolean", "description": "Legacy alias of cdc.mode == scd2." },
        "scd2_enabled": { "type": "boolean", "description": "Legacy flag — prefer cdc.mode." },
        "scd2_tracked_columns": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ],
          "description": "Legacy — prefer cdc.track."
        },
        "track_changes": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ],
          "description": "Legacy alias of scd2_tracked_columns."
        },
        "partition_enabled": { "type": "boolean" },
        "partition_columns": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ]
        },
        "event_time_column": { "type": "string" },
        "generation_mode": {
          "type": "string",
          "enum": ["snapshot", "delta", "delta_ready", "scd2", "scd2_ready"]
        },
        "columns": {
          "type": "array",
          "items": { "$ref": "#/$defs/Column" }
        }
      }
    },
    "CDC": {
      "type": "object",
      "description": "Unified change-data-capture configuration. Replaces the spread of legacy flags.",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["snapshot", "delta", "scd2"],
          "description": "snapshot = full overwrite each run. delta = emit I/U/D rows. scd2 = effective-dated history (implies delta)."
        },
        "track": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ],
          "description": "Columns whose changes trigger a new SCD2 version. Empty when mode != scd2."
        },
        "event_time": {
          "type": "string",
          "description": "Column used as the event time / monotonic ordering key."
        },
        "partition_by": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ],
          "description": "Partition key columns. Empty disables partitioning."
        }
      }
    },
    "Column": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "patternProperties": { "^(x-|_)": {} },
      "properties": {
        "name": { "type": "string" },
        "column_name": { "type": "string", "description": "Alias for name." },
        "description": { "type": "string" },
        "data_type": { "type": "string" },
        "length": { "type": "integer", "minimum": 0 },
        "precision": { "type": "integer", "minimum": 0 },
        "scale": { "type": "integer", "minimum": 0 },
        "null_rate": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "Fraction of values generated as NULL. `nullable: false` overrides this."
        },
        "distribution": {
          "type": "object",
          "description": "Statistical distribution descriptor — {name, params, data_min, data_max}. Produced by infer-config; drives numeric sampling.",
          "properties": {
            "name": { "type": "string" },
            "params": {},
            "data_min": {},
            "data_max": {}
          }
        },
        "example_value": { "description": "Canonical example — used by the mock renderers and API docs." },
        "type": { "type": "string", "description": "Alias for data_type." },
        "is_pk": { "type": "boolean" },
        "pk": { "type": "boolean" },
        "is_fk": { "type": "boolean" },
        "fk": { "type": "boolean" },
        "ref_table": { "type": "string" },
        "ref_column": { "type": "string" },
        "business_values": {
          "oneOf": [
            { "type": "array" },
            { "type": "string" }
          ]
        },
        "values": {
          "oneOf": [
            { "type": "array" },
            { "type": "string" }
          ],
          "description": "Alias for business_values."
        },
        "special_rules": { "type": "string" },
        "min_value": {},
        "max_value": {},
        "min": {},
        "max": {},
        "nullable": { "type": "boolean" },
        "is_business_key_component": { "type": "boolean" },
        "event_time": { "type": "boolean" },
        "partition_role": {
          "type": "string",
          "enum": ["partition_key", "event_time"]
        },
        "scd2_tracked": { "type": "boolean" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/Rule" },
          "description": "Layer A — same-row when/then rules."
        },
        "derived": {
          "type": "string",
          "description": "Layer B — same-row derived expression. Template ('{first} {last}') or =-prefixed expression ('={qty} * {price}')."
        }
      }
    },
    "Rule": {
      "type": "object",
      "required": ["when", "then"],
      "additionalProperties": false,
      "properties": {
        "when": { "$ref": "#/$defs/When" },
        "then": { "$ref": "#/$defs/Then" },
        "note": { "type": "string" }
      }
    },
    "When": {
      "type": "object",
      "description": "Condition tree. Keys are column names (mapped to operator dicts) or composite operators 'and' / 'or' (mapped to lists of sub-conditions).",
      "additionalProperties": true
    },
    "Then": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "description": "Constant override for the column." },
        "set_null": { "type": "boolean", "description": "Force the column to null." },
        "min": { "description": "Numeric or date min override." },
        "max": { "description": "Numeric or date max override." },
        "distribution": { "type": "object" },
        "null_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "business_values": {
          "oneOf": [
            { "type": "array" },
            { "type": "string" }
          ]
        },
        "special_rules": { "type": "string" }
      }
    },
    "Workflow": {
      "type": "object",
      "description": "Layer C — walks each row of a table through a state machine, back-filling only the timestamps for states actually visited.",
      "required": ["name", "table", "state_column", "transitions"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Identifier, used in logs and the generation report." },
        "table": { "type": "string", "description": "Table this workflow applies to." },
        "state_column": {
          "type": "string",
          "description": "Column that receives the terminal state. Overwritten — whatever generation produced is replaced."
        },
        "timestamps": {
          "type": "object",
          "description": "Map of column name -> state that produces it. The column is set when that state is visited and NULL when it is not.",
          "additionalProperties": { "type": "string" }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/WorkflowTransition" }
        },
        "start_state": {
          "type": "string",
          "description": "Where every row starts. Inferred when exactly one state is never a transition target; required otherwise (e.g. any cyclic workflow)."
        },
        "start_between": {
          "type": "array",
          "description": "[min, max] ISO dates bounding the first timestamp. Defaults to the last 365 days.",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2
        },
        "step_hours": {
          "type": "array",
          "description": "[min, max] gap in hours between consecutive state timestamps. Defaults to [1, 72].",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "note": { "type": "string" }
      }
    },
    "WorkflowTransition": {
      "type": "object",
      "description": "One edge of the state machine. Probabilities are read per source state; where they sum below 1, the remainder is the chance of stopping in that state.",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Chance of taking this edge given the row is in `from`. Defaults to 1.0."
        }
      }
    },
    "Relationship": {
      "type": "object",
      "required": ["source_table", "target_table"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "source_table": { "type": "string" },
        "source_columns": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ]
        },
        "source_column": { "type": "string" },
        "target_table": { "type": "string" },
        "target_columns": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ]
        },
        "target_column": { "type": "string" },
        "relationship_type": {
          "type": "string",
          "enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many"]
        },
        "cardinality": { "type": "string" },
        "preserve_on_delta": { "type": "boolean" },
        "active": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
