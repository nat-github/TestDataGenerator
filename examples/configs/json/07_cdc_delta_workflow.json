{
  "config_format": "sdp-json-v1",
  "run_settings": {
    "default_records_per_table": 1000
  },
  "tables": [
    {
      "name": "account_balances",
      "rows": 1000,
      "business_key_columns": [
        "account_id"
      ],
      "primary_key_columns": [
        "account_id"
      ],
      "cdc": {
        "mode": "delta",
        "event_time": "balance_at",
        "partition_by": [
          "posting_date"
        ]
      },
      "columns": [
        {
          "name": "account_id",
          "data_type": "N10",
          "is_pk": true,
          "is_business_key_component": true
        },
        {
          "name": "customer_name",
          "data_type": "VA64",
          "special_rules": "NAME"
        },
        {
          "name": "currency",
          "data_type": "VA3",
          "business_values": "EUR;USD;GBP"
        },
        {
          "name": "balance",
          "data_type": "DC",
          "min_value": -1000,
          "max_value": 100000
        },
        {
          "name": "status",
          "data_type": "VA10",
          "business_values": "ACTIVE;FROZEN;CLOSED"
        },
        {
          "name": "posting_date",
          "data_type": "D"
        },
        {
          "name": "balance_at",
          "data_type": "TS"
        }
      ]
    }
  ]
}