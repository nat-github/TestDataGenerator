{
  "config_format": "sdp-json-v1",
  "run_settings": {
    "default_records_per_table": 1000
  },
  "tables": [
    {
      "name": "transactions",
      "rows": 1000,
      "primary_key_columns": [
        "txn_id"
      ],
      "columns": [
        {
          "name": "txn_id",
          "data_type": "N10",
          "is_pk": true
        },
        {
          "name": "amount",
          "data_type": "DC",
          "min_value": 0.5,
          "max_value": 50000,
          "distribution": {
            "name": "norm",
            "params": [
              1200.0,
              450.0
            ],
            "data_min": 0.5,
            "data_max": 50000
          }
        },
        {
          "name": "rating",
          "data_type": "N10",
          "min_value": 1,
          "max_value": 5,
          "distribution": {
            "name": "uniform",
            "params": [
              1,
              5
            ]
          }
        },
        {
          "name": "currency",
          "data_type": "VA3",
          "business_values": "EUR;USD;GBP;JPY;INR"
        },
        {
          "name": "channel",
          "data_type": "VA10",
          "business_values": "ONLINE;MOBILE;BRANCH;ATM;PHONE"
        },
        {
          "name": "status",
          "data_type": "VA10",
          "business_values": "SETTLED;PENDING;FAILED;REVERSED"
        },
        {
          "name": "memo",
          "data_type": "VA256",
          "nullable": true,
          "null_rate": 0.9
        },
        {
          "name": "fx_rate",
          "data_type": "DC",
          "min_value": 0.5,
          "max_value": 1.5,
          "nullable": true,
          "null_rate": 0.6
        },
        {
          "name": "posted_at",
          "data_type": "TS",
          "nullable": false
        }
      ]
    }
  ]
}