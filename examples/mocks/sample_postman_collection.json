{
  "info": {
    "name": "Demo Books API",
    "version": { "raw": "1.0.0", "major": 1 },
    "description": "Sample Postman v2.1 collection — feed this into mock-init to see the reverse import.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "8d0f5b2a-4f17-4b3a-9d9c-2bbb3a47e110"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" }
  ],
  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "List books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?page=1&size=25",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "25" }
              ]
            },
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "description": "Returns a paginated list of books"
          },
          "response": [
            {
              "name": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "[{\"id\": 1, \"title\": \"The Pragmatic Programmer\", \"author\": \"Andy Hunt\", \"isbn\": \"9780201616224\"}, {\"id\": 2, \"title\": \"Designing Data-Intensive Applications\", \"author\": \"Martin Kleppmann\", \"isbn\": \"9781449373320\"}]"
            },
            {
              "name": "Unauthorized",
              "code": 401,
              "body": "{\"code\": \"UNAUTHORIZED\", \"message\": \"Missing or invalid Authorization header\"}"
            }
          ]
        },
        {
          "name": "Get book by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books/:id",
              "host": ["{{baseUrl}}"],
              "path": ["books", ":id"],
              "variable": [
                { "key": "id", "value": "1", "description": "The book's id" }
              ]
            },
            "header": []
          },
          "response": [
            {
              "name": "OK",
              "code": 200,
              "body": "{\"id\": 1, \"title\": \"The Pragmatic Programmer\", \"author\": \"Andy Hunt\"}"
            },
            {
              "name": "Not Found",
              "code": 404,
              "body": "{\"code\": \"NOT_FOUND\", \"message\": \"Book does not exist\"}"
            }
          ]
        },
        {
          "name": "Create book",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Driven Development\",\n  \"author\": \"Kent Beck\",\n  \"isbn\": \"9780321146533\"\n}"
            }
          },
          "response": [
            {
              "name": "Created",
              "code": 201,
              "body": "{\"id\": 3, \"title\": \"Test Driven Development\", \"author\": \"Kent Beck\", \"isbn\": \"9780321146533\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Authors",
      "item": [
        {
          "name": "Get author",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/authors/:id",
              "host": ["{{baseUrl}}"],
              "path": ["authors", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          },
          "response": [
            {
              "name": "OK",
              "code": 200,
              "body": "{\"id\": 1, \"name\": \"Andy Hunt\", \"books_count\": 5}"
            }
          ]
        }
      ]
    }
  ]
}
